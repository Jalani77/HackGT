# ─── Server ───────────────────────────────────────────────
PORT=4000
# Leave empty in dev to use a persistent in-memory MongoDB (server/.data/mongo).
MONGODB_URI=
# Atlas: add your IP (or 0.0.0.0/0 for hackathon demos) under Security → Network Access.
MONGODB_DB=campus-discovery
JWT_SECRET=change-me-to-a-long-random-string

# ─── AI recognition ───────────────────────────────────────
# openai | mock   (mock is used automatically if AI_API_KEY is empty)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ─── Image storage ────────────────────────────────────────
# local  → files saved under server/uploads and served at IMAGE_STORAGE_URL
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_URL=/uploads
IMAGE_STORAGE_KEY=

# ─── Game ─────────────────────────────────────────────────
DEFAULT_CAMPUS_ID=gatech
DEFAULT_CAMPUS_NAME=Georgia Tech

# ─── Client (dev) ─────────────────────────────────────────
# Set to 1 to serve Vite over HTTPS so phones on your LAN can use the camera.
VITE_HTTPS=0
